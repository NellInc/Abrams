.DS_Store
# Original games stay local, including case variants and nested copies.
# Working if: git check-ignore GAME/SIM.EXE GENESIS/game.md game/SIM.EXE succeeds.
[Gg][Aa][Mm][Ee]/
[Gg][Ee][Nn][Ee][Ss][Ii][Ss]/
local-art/
local-audio/
*.pdf
reference/
artifacts/
.runtime/
.godot/
*.tmp
*.log
__pycache__/
*.pyc
.env
.env.*
builds/
# Decompressed original resources (inspect_scenarios --extract) stay local.
# Working if: git check-ignore tools/SCENARIO.DAT.decoded succeeds.
*.decoded
/web-prototype/.generated/
/capture/
# Box-art working copies and generation intermediates stay local. The approved
# cover and icon are published only from docs/images (website/asset-provenance.json).
# Working if: git check-ignore branding/abrams-icon.png tmp/custom-icons/abrams-app/final.png succeeds.
/branding/*.png
/tmp/custom-icons/
# Generated document previews stay local.
# Working if: git check-ignore tmp/pdfs/field-guide/final/contact.png succeeds.
/tmp/pdfs/

# Authored player references, never the original manual.
# Working if: these two PDFs are trackable while the original manual remains ignored.
!/docs/player-reference/keyboard-controls.pdf
!/docs/player-reference/field-guide.pdf

# Public authored guide, never the source manual.
# Working if: this one website PDF is trackable and source PDFs remain ignored.
!/website/dist/assets/guides/field-guide.pdf

# The authored controls PDF belongs beside the authored field guide.
# Working if: these two website PDFs are trackable; the original manual remains ignored.
!/website/dist/assets/guides/keyboard-controls.pdf

# Local session output: Playwright captures of original-game pixels, PDF
# scratch and background job state.
# Working if: git check-ignore output/playwright work succeeds.
/output/
/work/

# Machine-local runtime aliases and build locks never enter a source commit.
# Working if: git check-ignore godot/godot website/dist/play/.generated/.abrams-build.lock succeeds.
/godot/godot
/website/dist/play/.generated/.abrams-build.lock
