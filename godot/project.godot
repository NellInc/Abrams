; Abrams reconstruction. Proprietary reference material lives OUTSIDE res://.
config_version=5

[application]
config/name="M1 Abrams Battle Tank Remastered"
; Keep the pre-rename user:// location, including calibration saves.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Abrams - Reconstruction"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/minimum_display_time=0
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[editor]
; Serialize first-run imports to avoid the bundled engine's font-import race.
import/use_multiple_threads=false

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/dpi/allow_hidpi=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
textures/default_filters/anisotropic_filtering_level=4

[physics]
common/physics_ticks_per_second=60
